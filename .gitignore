# ==========================================
# Python (FastAPI / backend) 相关
# ==========================================
# 虚拟环境（必须忽略！包含大量本地库文件）
venv/
env/
.venv/
ENV/

# Python 编译文件
__pycache__/
*.py[cod]
*$py.class

# 测试与缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ⚠️ 极其重要：环境变量文件（包含你的 DeepSeek、Pinecone Key！）
.env
.env.*
!.env.example  # 允许上传示例文件，避免泄露真实 Key

# 日志文件
*.log
logs/

# ==========================================
# Node.js / Next.js (frontend) 相关
# ==========================================
# 依赖包（非常大，绝不能上传）
node_modules/
.pnp
.pnp.js

# Next.js 构建产物
.next/
out/
build/
dist/

# 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 环境变量
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# 编辑器 / 操作系统 相关
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp